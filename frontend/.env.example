# Frontend configuration (Vite). These values are PUBLIC and end up in the browser bundle.
# Never put the service-role/secret key or SMTP credentials here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Browser-restricted Google Maps JavaScript API key for clinic maps.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Google Maps map ID; defaults to Google's demo map ID.
VITE_GOOGLE_MAP_ID=
# Base URL of the backend API. Leave empty in development (Vite proxies /api to localhost:4000).
VITE_API_URL=
