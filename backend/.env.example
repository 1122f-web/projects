# ---------------------------------------------------------------------------
# MediConnect backend configuration. Copy to backend/.env and fill in.
# NEVER commit backend/.env. Values below are placeholders only.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public key: the "anon" key or a "sb_publishable_..." key
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret key: the "service_role" key or a "sb_secret_..." key. Server only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Frontend origin(s) allowed by CORS, comma-separated. The first one is used for links in emails.
FRONTEND_URL=http://localhost:5173
# Optional: public app URL used in email links (defaults to the first FRONTEND_URL)
# APP_URL=https://app.example.com

# Set to the number of proxies in front of the API (1 on Render/Railway/Fly) so rate limits see real client IPs
TRUST_PROXY=0
LOG_LEVEL=info

# Background worker inside the API process (email outbox every 30 s, reminders every 5 min)
ENABLE_WORKER=true
# Optional: enables POST /api/internal/run-jobs for an external scheduler (min 24 chars)
# CRON_SECRET=generate-a-long-random-string-here

# Video consultations (Daily, https://dashboard.daily.co -> Developers -> API key).
# Leave empty to disable video calls; the Join button then explains they are unavailable.
DAILY_API_KEY=

# Email (any SMTP provider: Resend, SendGrid, Mailgun, Postmark, Amazon SES, ...)
# Leave SMTP_HOST empty to disable email; in-app notifications still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MediConnect <no-reply@your-domain.com>
